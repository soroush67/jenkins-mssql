# Rendered by roles/mssql - generated by Ansible, do not edit by hand.
networks:
  db-net:
    name: db-net
    external: true

services:
  mssql:
    image: "{{ mssql_image }}"
    container_name: "{{ mssql_container_name }}"
    hostname: "{{ mssql_hostname }}"

    # Not root - the image's own built-in "mssql" user (uid/gid 10001),
    # confirmed directly. Unlike postgres's image, this one already
    # bakes in USER mssql by default in its own Dockerfile.
    user: "{{ mssql_run_uid }}:{{ mssql_run_gid }}"

    environment:
      - ACCEPT_EULA=Y
      - "MSSQL_SA_PASSWORD={{ mssql_sa_password }}"
      - "MSSQL_PID={{ mssql_pid }}"

    networks:
      - db-net

    ports:
      - "{{ mssql_port }}:1433"

    restart: unless-stopped
    mem_limit: "{{ mssql_mem_limit }}"
    mem_reservation: "{{ mssql_mem_reservation }}"
    cpus: {{ mssql_cpus }}
    cpu_shares: {{ mssql_cpu_shares }}

    # Least-privilege by default. cap_add: NET_BIND_SERVICE is required,
    # not optional - confirmed directly: /opt/mssql/bin/sqlservr has
    # `cap_net_bind_service=ep` set as a file capability (`getcap`
    # confirmed this), and the kernel refuses to honor a binary's own
    # file capabilities at exec time unless that capability is also
    # present in the container's capability bounding set - with a bare
    # cap_drop: ALL (bounding set empty), sqlservr failed to even launch
    # ("/opt/mssql/bin/launch_sqlservr.sh: line 20:
    # /opt/mssql/bin/sqlservr: Operation not permitted"), before this
    # was added back. No other capability was needed - a broader set
    # (CHOWN, DAC_OVERRIDE, FOWNER, SETUID, SETGID, SYS_PTRACE,
    # SYS_RESOURCE, IPC_LOCK) was tried and confirmed NOT to fix it on
    # its own, ruling those out one at a time before finding this one.
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - "no-new-privileges:true"

    healthcheck:
      # -C (trust server certificate) is required for mssql-tools18's
      # sqlcmd, confirmed directly - v18 encrypts connections by default
      # and refuses an unverified self-signed cert otherwise.
      test: ["CMD", "/opt/mssql-tools18/bin/sqlcmd", "-S", "localhost", "-U", "sa", "-P", "{{ mssql_sa_password }}", "-C", "-Q", "SELECT 1"]
      interval: 10s
      timeout: 10s
      retries: 10
      start_period: 60s

    volumes:
      - "{{ mssql_data_root }}:/var/opt/mssql"
      - "/etc/timezone:/etc/timezone:ro"
      - "/etc/localtime:/etc/localtime:ro"
