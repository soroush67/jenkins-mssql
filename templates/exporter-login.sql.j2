-- Rendered by roles/mssql - generated by Ansible, do not edit by hand.
--
-- Unlike postgres/mongo, SQL Server has no docker-entrypoint-initdb.d
-- equivalent that runs once against a fresh data directory - this is
-- executed via sqlcmd (docker exec) authenticated as sa on every
-- deploy instead, so it needs to be idempotent itself: CREATE on first
-- deploy, ALTER (to resync the password) on every one after.
--
-- VIEW SERVER STATE is the minimum this exporter's own queries need -
-- confirmed directly by reading its source (sys.dm_os_performance_
-- counters, sys.dm_io_virtual_file_stats, sys.dm_os_process_memory,
-- sys.dm_os_sys_memory, sys.databases, sys.master_files) - never the
-- sa account itself.
IF NOT EXISTS (SELECT 1 FROM sys.server_principals WHERE name = '{{ mssql_exporter_user }}')
BEGIN
    CREATE LOGIN [{{ mssql_exporter_user }}] WITH PASSWORD = '{{ mssql_exporter_password }}', CHECK_POLICY = ON;
END
ELSE
BEGIN
    ALTER LOGIN [{{ mssql_exporter_user }}] WITH PASSWORD = '{{ mssql_exporter_password }}';
END
GRANT VIEW SERVER STATE TO [{{ mssql_exporter_user }}];
